# Required for the local Docker Compose deployment.
# Copy this file to .env and replace the placeholders with real secrets.
#
# Never commit the resulting .env file.

# CrowdSec bouncer authentication key used by the Marley application.
CROWDSEC_BOUNCER_KEY=replace-with-crowdsec-bouncer-key

# Grafana administrator password.
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-admin-password
